import os
import json
from itertools import product

from pmma.config_file_manipulator import substitute_labels, save_config, yaml_to_json_string

# Load and process the configuration file
configfile: "config.yaml"

# Substitute labels in the config and save the updated config
config = substitute_labels('config.yaml')
save_config(config, os.path.join(config['paths']['experiment_dir'], "config.yaml"))

# Convert configurations to JSON strings for use in shell commands
data_preprocessing_args = yaml_to_json_string(str(config["experiment"]["args"]["data_preprocessing"]))
extraction_info = yaml_to_json_string(str(config["experiment"]["extraction_info"]))

# Extract variables from the config for use in rules
SPECTRUM_TYPES = config["experiment"]["extraction_info"]["spectrum_types"]
NOSE_ORIENTATIONS = config["experiment"]["extraction_info"]["nose_orientations"]
SPOT_MUS = config["experiment"]["extraction_info"]["SpotMUs"]
PROTON_ENERGIES = config["experiment"]["extraction_info"]["proton_energies"]
DETECTORS = config["experiment"]["extraction_info"]["detectors"]

# -----------------------------------------------------------------------------
# Base configuration
# -----------------------------------------------------------------------------
BASE_DIR = os.path.abspath(config["paths"]["base_dir"])
EXPERIMENT_NAME = config["experiment"]["experiment_name"]

# Fix: EXPERIMENT_DIR is used to build itself; build it from base_dir instead
EXPERIMENT_DIR = os.path.join(EXPERIMENT_DIR, EXPERIMENT_NAME)
LOGS_DIR = os.path.join(EXPERIMENT_DIR, "logs")

RAW_DATA_DIR = os.path.abspath(config["paths"]["root_data_dir"])
PREPROCESSED_DIR = os.path.abspath(config["paths"]["processed_npy_data_dir"])

# Outputs 
COMPLETION_DIR = os.path.join(EXPERIMENT_DIR, "data", "completion_files")
DATA_PATH_TABLE = os.path.join(EXPERIMENT_DIR, "data", "data_path_table.csv")
FIGURES_DIR = os.path.join(EXPERIMENT_DIR, "figures") 

# Scripts:
SCRIPTS_ROOT = os.path.join(BASE_DIR, "data_processing")

SCRIPTS = {
    "create_data_path_table": os.path.join(BASE_DIR, "data_preparation/create_data_path_table_proc.py"),
    "preprocess_data": os.path.join(SCRIPTS_ROOT, "preprocess_data.py"),
    "aggregate_detectors": os.path.join(SCRIPTS_ROOT, "aggregate_detectors.py"),
}


# Canonicalize nested dicts
config.setdefault("paths", {})
config["paths"].setdefault("data", {})
config["paths"].setdefault("output_files", {})
config["paths"].setdefault("scripts", {})

config["paths"]["scripts"] = SCRIPTS

# Provide commonly-used absolute paths
config["paths"]["experiment_dir"] = EXPERIMENT_DIR
config["paths"]["logs_dir"] = LOGS_DIR

# Data locations used by rules
config["paths"]["data"]["main_data_dir"] = RAW_DATA_DIR
config["paths"]["data"]["preprocessed_dir"] = PREPROCESSED_DIR

# Output locations used by rule all / create_data_path_table / preprocess_data
config["paths"]["output_files"].setdefault("completion_files_dir", COMPLETION_DIR)
config["paths"]["output_files"].setdefault("data_path_table", DATA_PATH_TABLE)
config["paths"]["output_files"].setdefault("figures", FIGURES_DIR)


# Define the final target of the pipeline
rule all:
    input:
        # Ensure the updated config is included
        "config.yaml",
        # Completion files for all combinations of parameters
        expand(
            os.path.join(
                config['paths']['output_files']['completion_files_dir'],
                "preprocess_data_complete_{spectrum_type}_det{detector}.txt"
            ),
            spectrum_type=SPECTRUM_TYPES,
            detector=DETECTORS
        ),
        os.path.join(
            config['paths']['output_files']['completion_files_dir'],
            "aggregate_detectors_complete.txt"
        ),
        # Data path table
        config['paths']['output_files']['data_path_table']

# Rule to create a configuration report (if needed)
rule create_config_report:
    output:
        report(
            "config.yaml",
            category="Configuration",
            labels={
                "File": "Config-file",
                "Type": "yaml"
            }
        )
    threads: 1
    resources:
        time="1:00:00",
        mem_per_cpu="1G",
    shell:
        """
        # Add commands to process the config.yaml if necessary
        """


# Rule to create the data path table
rule create_data_path_table:
    output:
        output_file=report(
            config['paths']['output_files']['data_path_table'],
            category="Data table"
        )
    params:
        script=config['paths']['scripts']['create_data_path_table'],
        root_dir=config['paths']['data']['main_data_dir'],
        extraction_info=json.dumps(extraction_info)
    log:
        os.path.join(
            config['paths']['logs_dir'],
            'data_table_creation',
            'create_data_path_table.log'
        )
    threads: 64
    resources:
        time="24:00:00",
        mem_per_cpu="1G",
    shell:
        """
        python {params.script} \
            --root_dir {params.root_dir} \
            --output_file {output.output_file} \
            --threads {threads} \
            --extraction_info {params.extraction_info} > {log} 2>&1
        """

# Rule for preprocessing data
rule preprocess_data:
    input:
        data_table_path=config['paths']['output_files']['data_path_table']
    output:
        completion_file_path=os.path.join(
            config['paths']['output_files']['completion_files_dir'],
            "preprocess_data_complete_{spectrum_type}_det{detector}.txt")
    params:
        script=config['paths']['scripts']['preprocess_data'],
        spectrum_type="{spectrum_type}",
        detector="{detector}",
        preprocessed_dir=config['paths']['data']['preprocessed_dir'],
        figures_path=os.path.join(
            config['paths']['output_files']['figures'],
            "{spectrum_type}_det{detector}"
        ),
        data_preprocessing_args=json.dumps(data_preprocessing_args)
    threads: 128
    resources:
        time="24:00:00",
        mem_per_cpu="3G",
    log:
        os.path.join(
            config['paths']['logs_dir'],
            'data_processing',
            'process_data_{spectrum_type}_det{detector}.log'
        )
    shell:
        """
        python {params.script} \
            --data_table_path {input.data_table_path} \
            --output_dir {params.preprocessed_dir} \
            --completion_file_path {output.completion_file_path} \
            --figures_path {params.figures_path} \
            --spectrum_type {params.spectrum_type} \
            --detector {params.detector} \
            --data_preprocessing_args {params.data_preprocessing_args} \
            --threads {threads} > {log} 2>&1
        """


# Rule for aggregating detectors
rule aggregate_detectors:
    input:
        # Completion files from preprocess_data for all detectors and parameter combinations
        expand(
            os.path.join(
                config['paths']['output_files']['completion_files_dir'],
                "preprocess_data_complete_{spectrum_type}_det{detector}.txt"
            ),
        spectrum_type=SPECTRUM_TYPES,
        detector=DETECTORS
        )
    output:
        completion_file=os.path.join(
            config['paths']['output_files']['completion_files_dir'],
            "aggregate_detectors_complete.txt")
    params:
        script=config['paths']['scripts']['aggregate_detectors'],
        preprocessed_dir=config['paths']['data']['preprocessed_dir'],
        data_preprocessing_args=json.dumps(data_preprocessing_args)
    log:
        os.path.join(
            config['paths']['logs_dir'],
            'detector_aggregation',
            'aggregate_detectors.log'
        )
    threads: 128
    resources:
        time="24:00:00",
        mem_per_cpu="3G"
    shell:
        """
        python {params.script} \
            --threads {threads} \
            --data_preprocessing_args {params.data_preprocessing_args} \
            --output_dir {params.preprocessed_dir} > {log} 2>&1
        touch {output.completion_file}
        """